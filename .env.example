# Copy this file to ".env" and fill in keys to enable the OPTIONAL IP intelligence feature.
# The app works fully offline without them. Never commit your real .env file.

# Geolocation / ASN / organisation (free tier available): https://ipinfo.io
IPINFO_TOKEN=

# Reputation (free tier available): https://www.abuseipdb.com
ABUSEIPDB_API_KEY=
